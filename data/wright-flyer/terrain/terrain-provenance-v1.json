  "max_abs_residual_m": 3.549,
  "region": "rows 10-16, cols 3-13",
  "n_points": 77,
  "slope_magnitude": 0.000606,
  "note": "plane fit by least squares over the launch region; residuals/slopes are the FlatnessCertificate inputs (E3.4/E4.4a consume; certificate issuance is theirs)"
 },
