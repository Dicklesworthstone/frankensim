  "flight": "1905-10-05, 24.2 mi (38.95 km) in ~29.7 laps",
  "lap_length_m": 1311.4,
  "assumed_track": "oval ~500 x 160 m half-extents inside the prairie (first-circle lap 1904-09-20 was ~1244 m; 1905 laps ~1311 m — consistent)",
