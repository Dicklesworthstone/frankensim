+//! Demo-site export of REAL simulation state (mode shapes and modal
+//! coordinates) for visualization. Inert unless FSIM_VIZ_DIR is set; it never
+//! changes mechanics, acoustics or any published artifact.
+use std::{fs::{File,OpenOptions},io::{BufWriter,Write},sync::{Mutex,OnceLock}};
+fn dir()->Option<&'static str>{
+    static D:OnceLock<Option<String>>=OnceLock::new();
+    D.get_or_init(||std::env::var("FSIM_VIZ_DIR").ok()).as_deref()
+}
+fn append(name:&str,text:&str){
+    if let Some(d)=dir(){
+        if let Ok(mut f)=OpenOptions::new().create(true).append(true).open(format!("{d}/{name}")){let _=f.write_all(text.as_bytes());}
+    }
+}
+/// Curved shell: per node, the mass-normalized translation of every retained
+/// coordinate (rigid heave first), read through the reduction's own point port.
+pub(crate) fn shell(nodes:&[[f64;3]],tris:&[[usize;3]],omegas:&[f64],
+    port:&dyn Fn(usize,[f64;3],[f64;3])->Option<Vec<f64>>,offset:usize){
+    if dir().is_none(){return;}
+    let modes=omegas.len();
+    let mut owner=vec![None;nodes.len()];
+    for (t,tri) in tris.iter().enumerate(){for (c,&v) in tri.iter().enumerate(){if owner[v].is_none(){owner[v]=Some((t,c));}}}
+    let mut s=format!("{{\"kind\":\"shell\",\"offset\":{offset},\"modes\":{modes},\"omegas\":{omegas:?},\"nodes\":{nodes:?},\"tris\":{tris:?},\"shapes\":[");
+    for (i,o) in owner.iter().enumerate(){
+        if i>0{s.push(',');}
+        let mut row=vec![0.0_f64;3*modes];
+        if let Some((t,c))=o{
+            let mut b=[0.0;3];b[*c]=1.0;
+            for d in 0..3{
+                let mut direction=[0.0;3];direction[d]=1.0;
+                if let Some(w)=port(*t,b,direction){for (k,v) in w.iter().enumerate().take(modes){row[3*k+d]=*v;}}
+            }
+        }
+        s.push_str(&format!("{row:?}"));
+    }
+    s.push_str("]}\n");append("shapes.jsonl",&s);
+}
+/// Flat prestressed head: transverse mass-normalized shape of each mode at each node.
+pub(crate) fn head(index:usize,nodes:&[(f64,f64)],tris:&[[usize;3]],offset:usize,omegas:&[f64],
+    shape:&dyn Fn(usize,usize)->f64){
+    if dir().is_none(){return;}
+    let xy:Vec<[f64;2]>=nodes.iter().map(|p|[p.0,p.1]).collect();
+    let mut s=format!("{{\"kind\":\"head\",\"head\":{index},\"offset\":{offset},\"modes\":{},\"omegas\":{omegas:?},\"nodes\":{xy:?},\"tris\":{tris:?},\"shapes\":[",omegas.len());
+    for node in 0..nodes.len(){
+        if node>0{s.push(',');}
+        let row:Vec<f64>=(0..omegas.len()).map(|mode|shape(mode,node)).collect();
+        s.push_str(&format!("{row:?}"));
+    }
+    s.push_str("]}\n");append("shapes.jsonl",&s);
+}
+struct Sink{out:BufWriter<File>,step:u64,every:u64}
+static SINK:OnceLock<Option<Mutex<Sink>>>=OnceLock::new();
+/// Interleaved mass-normalized q,p for the first `coordinates` modal coordinates.
+pub(crate) fn state(x:&[f64],coordinates:usize,dt_s:f64){
+    let Some(d)=dir() else {return;};
+    let sink=SINK.get_or_init(||{
+        let every=std::env::var("FSIM_VIZ_EVERY").ok().and_then(|v|v.parse().ok()).unwrap_or(1_u64).max(1);
+        append("meta.json",&format!("{{\"coordinates\":{coordinates},\"every\":{every},\"dt_s\":{dt_s:e},\"layout\":\"f32 little-endian, per record: q0,p0,q1,p1,...\"}}\n"));
+        File::create(format!("{d}/state.f32")).ok().map(|f|Mutex::new(Sink{out:BufWriter::new(f),step:0,every}))
+    });
+    if let Some(sink)=sink{
+        let mut s=sink.lock().unwrap();
+        if s.step%s.every==0{
+            for v in &x[..(2*coordinates).min(x.len())]{let _=s.out.write_all(&(*v as f32).to_le_bytes());}
+        }
+        s.step+=1;
+    }
+}
+pub(crate) fn finish(){
+    if let Some(Some(sink))=SINK.get(){let _=sink.lock().unwrap().out.flush();}
+}
+/// Flushes the state sink when a mechanics loop ends, including early error returns.
+pub(crate) struct Guard;
+impl Drop for Guard {fn drop(&mut self){finish();}}
