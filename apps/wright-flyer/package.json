{
  "name": "wright-flyer",
  "private": true,
  "version": "0.0.1",
  "description": "First Flight — browser front end for the FrankenSim Wright Flyer simulation (bead wf-root-guzez.1.2, E0.2)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "wasm": "wasm-pack build ../../crates/fs-flyer-wasm --target web --release --out-dir ../../apps/wright-flyer/src/wasm-pkg",
    "test:sim": "node --test test/simFacade.test.ts",
    "test:e2e": "node --test test/e2eLib.test.mjs && node e2e/run.mjs",
    "test:e2e:falsifier": "node e2e/run.mjs --falsifier"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "puppeteer-core": "^25.10.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
