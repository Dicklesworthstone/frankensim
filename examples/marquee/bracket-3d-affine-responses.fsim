(fsim-sdf3-study :version 1
  (metadata
    :name "3d-material-with-serviceability-and-strength"
    :created "2026-11-09"
    :context-of-use "Numerical design under self-weight and a continuous external-load ball with signed displacement, support-force and support-moment limits"
    :intended-decision "Reduce dilated material while compliance, sampled strength and every original serviceability bound remain feasible"
    :decision-gate scoping-estimate
    :consequence advisory)
  (seeds :root 1337)
  (budgets
    :wall-seconds 600.0
    :memory-bytes 536870912
    :linear-iterations 250000
    :per-solve-iterations 50000
    :quadrature-boxes 1000000
    :quadrature-points 1000000)
  (capabilities "optimization.marquee-topopt" "geometry.sdf" "physics.cutfem")
  (units :storage "SI")
  (domain
    :type physical-curved-height-sdf
    :bounds ((0.0 0.0 0.0) (1.0 1.0 1.0))
    :height-m 0.7
    :curvature-per-m 0.1)
  (physics
    :type elasticity-3d
    :initial-level 1
    :maximum-level 1
    :maximum-leaves 8
    :youngs-modulus-pa 1024000.0
    :poissons-ratio 0.3)
  (scenario
    :fixed-boundary (embedded :axis x :fraction (0.0 0.5) :penalty 32.0)
    :body-loads (
      (load :density-n-m3 (0.0 -1.0 0.0) :weight 1.0)
      (load :density-n-m3 (0.0 -1.0 -0.5) :weight 1.0)))
  (objective :type dilated-volume-fraction :sense minimize :unit "1")
  (optimizer
    :type affine-load-space-limited-simp
    :initial-density 0.75
    :filter-radius-m 0.15
    :max-updates 80
    :density-floor 0.05
    :compliance-limit-j 0.00009765625
    :threshold-offset 0.1
    :max-optimizer-evaluations 2000
    :max-backtracks 40
    :tolerance 0.000002
    :penal 3.0
    :beta 2.0)
  (material-acceleration
    :density-kg-m3 0.2
    :acceleration-m-s2 (0.0 0.0 -1.0)
    :max-stencil-terms 100000)
  (affine-strength
    :stress-limit-pa 400.0
    :relaxation-power 1.0
    :aggregation-power 8.0
    :max-stress-point-fields 100000
    :joint-sharpness 40.0)
  (affine-responses
    :sharpness 40.0
    :joint-sharpness 40.0
    :limits (
      (mean-displacement :name "tip-z-lower" :axis z
        :x-fraction (0.5 1.0) :sense at-least :bound-m -0.00001953125 :scale-m 0.00001953125)
      (mean-displacement :name "tip-z-upper" :axis z
        :x-fraction (0.5 1.0) :sense at-most :bound-m 0.00001953125 :scale-m 0.00001953125)
      (support-force :name "support-z-lower" :axis z
        :sense at-least :bound-n -2.0 :scale-n 2.0)
      (support-force :name "support-z-upper" :axis z
        :sense at-most :bound-n 2.0 :scale-n 2.0)
      (support-moment :name "support-y-upper" :axis y
        :about-m (0.0 0.0 0.0) :sense at-most :bound-n-m 1.0 :scale-n-m 1.0))))
