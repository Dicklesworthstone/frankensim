(fsim-sdf3-study :version 1
  (metadata
    :name "multilevel-3d-cantilever"
    :created "2026-10-10"
    :context-of-use "Numerical CutFEM SIMP design with density-consistent multilevel solves and goal-guided refinement"
    :intended-decision "Explore a volume-limited design using sparse coarse corrections instead of a single dense correction grid"
    :decision-gate scoping-estimate
    :consequence advisory)
  (seeds :root 1337)
  (budgets
    :wall-seconds 300.0
    :memory-bytes 1073741824
    :linear-iterations 250000
    :per-solve-iterations 50000
    :quadrature-boxes 1000000
    :quadrature-points 1000000)
  (capabilities
    "optimization.marquee-topopt"
    "geometry.sdf"
    "physics.cutfem")
  (units :storage "SI")
  (domain
    :type physical-curved-height-sdf
    :bounds ((0.0 0.0 0.0) (1.0 1.0 1.0))
    :height-m 0.7
    :curvature-per-m 0.1)
  (physics
    :type elasticity-3d
    :initial-level 2
    :maximum-level 5
    :maximum-leaves 2048
    :youngs-modulus-pa 1.0
    :poissons-ratio 0.3)
  (scenario
    :fixed-boundary left
    :body-loads (
      (load :density-n-m3 (0.0 -1.0 0.0) :weight 0.3)
      (load :density-n-m3 (0.0 0.0 -1.0) :weight 0.7)))
  (objective :type compliance :sense minimize :unit "J")
  (optimizer
    :type adaptive-simp
    :initial-density 0.5
    :volume-fraction 0.5
    :filter-radius-m 0.15
    :updates-per-stage 1
    :move-limit 0.15
    :marking-fraction 0.5
    :max-marks 2
    :schedule ((1.0 1.0) (2.0 2.0)))
  (linear-solver
    :type multilevel
    :coarsest-level 0
    :max-transfer-terms 500000
    :max-matrix-entries 500000
    :max-galerkin-products 100000000
    :max-diagonal-contributions 100000000))
