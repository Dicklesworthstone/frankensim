(fsim-study :version 1
  (metadata
    :name "marquee-bracket-2d"
    :created "2026-09-15"
    :context-of-use "2-D plane-strain free-boundary topology-optimization integration; numerical/software evidence only"
    :intended-decision "Demonstrate the canonical study path on an evolving elasticity level set"
    :decision-gate scoping-estimate
    :consequence advisory)
  (versions :schema 1)
  (seeds :root 1337)
  (budgets
    :wall-time 300.0 s
    :memory 536870912 B
    :max-iterations 32)
  (capabilities
    "optimization.marquee-topopt"
    "geometry.sdf"
    "physics.cutfem"
  )
  (units :storage "SI")
  (domain
    :type sdf-plate-with-holes
    :bounds ((0.0 0.0) (1.0 1.0))
    :initial-holes (
      (hole :center (0.35 0.5) :radius 0.12)
      (hole :center (0.65 0.5) :radius 0.12)
    ))
  (physics
    :type elasticity-2d
    :mesh-level 4
    :youngs-modulus-pa 70000000000.0
    :poissons-ratio 0.3)
  (scenario
    :fixed-boundary left
    :load-region right
    :load-traction-pa 1000000.0
    :load-direction (0.0 -1.0)
    :load-band (0.375 0.625))
  (objective :type compliance :sense minimize :unit "J")
  (constraints :volume-fraction 0.45)
  (optimizer
    :type level-set-compliance
    :move-cells 0.35
    :band-cells 6.0
    :ell0 0.0
    :mu-al 4.0
    :sobolev-alpha 2.0
    :nucleation-period 4
    :hole-radius-cells 1.5
    :steps 32)
)
