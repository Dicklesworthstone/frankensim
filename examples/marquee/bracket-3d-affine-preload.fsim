(fsim-sdf3-study :version 1
  (metadata
    :name "3d-robust-stiffness-with-fixed-preload-and-self-weight"
    :created "2026-11-09"
    :context-of-use "Numerical stiffness design under known reference body and pressure preload, changing material self-weight and a continuous external load ball"
    :intended-decision "Minimize worst compliance within the material-volume allowance while retaining signed serviceability and sampled-strength limits through an independently assessed finer-grid redesign"
    :decision-gate scoping-estimate
    :consequence advisory)
  (seeds :root 1337)
  (budgets
    :wall-seconds 1200.0
    :memory-bytes 2147483648
    :linear-iterations 250000
    :per-solve-iterations 50000
    :quadrature-boxes 1000000
    :quadrature-points 1000000)
  (capabilities "optimization.marquee-topopt" "geometry.sdf" "physics.cutfem")
  (units :storage "SI")
  (domain
    :type physical-curved-height-sdf
    :bounds ((0.0 0.0 0.0) (1.0 1.0 1.0))
    :height-m 0.7
    :curvature-per-m 0.1)
  (physics
    :type elasticity-3d
    :initial-level 1
    :maximum-level 3
    :maximum-leaves 512
    :youngs-modulus-pa 1000.0
    :poissons-ratio 0.3)
  (scenario
    :fixed-boundary (embedded :axis x :fraction (0.0 0.5) :penalty 32.0)
    :body-loads (
      (load :density-n-m3 (0.0 -1.0 0.0) :weight 1.0)
      (load :density-n-m3 (0.0 -1.0 -0.5) :weight 1.0)))
  (objective :type compliance :sense minimize :unit "J")
  (optimizer
    :type affine-load-space-simp
    :initial-density 0.75
    :filter-radius-m 0.15
    :max-updates 80
    :density-floor 0.05
    :volume-fraction 0.9
    :compliance-reference-j 0.01
    :threshold-offset 0.1
    :max-optimizer-evaluations 2000
    :max-backtracks 40
    :tolerance 0.000002
    :penal 3.0
    :beta 2.0)
  (material-acceleration
    :density-kg-m3 0.2
    :acceleration-m-s2 (0.0 0.0 -1.0)
    :max-stencil-terms 100000)
  (affine-dead-load
    :body-n-m3 (0.0 0.0 -0.1)
    :surface (pressure :pa 0.1 :x-fraction (0.5 1.0)))
  (affine-strength
    :stress-limit-pa 400.0
    :relaxation-power 1.0
    :aggregation-power 8.0
    :max-stress-point-fields 100000
    :joint-sharpness 40.0)
  (affine-responses
    :sharpness 40.0
    :joint-sharpness 40.0
    :limits (
      (mean-displacement :name "tip-z-lower" :axis z
        :x-fraction (0.5 1.0) :sense at-least :bound-m -0.02 :scale-m 0.02)
      (mean-displacement :name "tip-z-upper" :axis z
        :x-fraction (0.5 1.0) :sense at-most :bound-m 0.02 :scale-m 0.02)
      (support-force :name "support-z-lower" :axis z
        :sense at-least :bound-n -2.0 :scale-n 2.0)
      (support-force :name "support-z-upper" :axis z
        :sense at-most :bound-n 2.0 :scale-n 2.0)
      (support-moment :name "support-y-upper" :axis y
        :about-m (0.0 0.0 0.0) :sense at-most :bound-n-m 1.0 :scale-n-m 1.0)))
  (affine-grid-assessment
    :max-transfer-terms 500000
    :compliance-change-tolerance 0.02
    :response-change-tolerance 0.02
    :stress-change-tolerance 0.02
    :inventory-change-tolerance 0.0001)
  (affine-grid-refinement
    :max-updates 20
    :max-optimizer-evaluations 500))
