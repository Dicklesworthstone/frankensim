{
  "schema": "frankensim.cooling-network-uq.v1",
  "seed": "73",
  "samples": 32,
  "wall_seconds": 300,
  "temperature_limit_k": 303,
  "correlation": {"kind": "joint-gaussian", "matrix": [[1, 0.4], [0.4, 1]]},
  "parameters": [
    {
      "target": {"kind": "inlet-temperature", "index": 0},
      "distribution": {"kind": "gaussian", "mean": 300, "std_dev": 0.2}
    },
    {
      "target": {"kind": "component-power", "component": "chip"},
      "distribution": {"kind": "gaussian", "mean": 1, "std_dev": 0.02}
    }
  ]
}
