  "solid": {
    "vertices_m": [[0, 0, 0], [1, 0, 0], [0, 1, 0], [0, 0, 1]],
    "tetrahedra": [[0, 1, 2, 3]],
    "conductivity_w_m_k": 10,
    "component_power": {
      "total_w": 1000,
      "relative_tolerance": 1e-12,
      "components": [{ "name": "device", "watts": 1000, "vertices": [0, 1, 2, 3] }]
    },
    "adiabatic_remainder": false,
    "surfaces": [{
      "name": "wall",
      "faces": [[1, 2, 3], [0, 2, 3], [0, 1, 3], [0, 1, 2]],
      "htc_w_m2_k": 2
    }]
  },
  "objective": { "mean_wall_region": "wall", "gradient": false },
  "transient": {
    "enthalpy": {
      "material_card_identity": "8080808080808080808080808080808080808080808080808080808080808080",
      "source": "Synthetic equilibrium chart; declaration, not a resolved material receipt",
      "reference_density_kg_m3": 10,
      "knots": [
        { "specific_enthalpy_j_kg": 0, "temperature_k": 250, "liquid_mass_fraction": 0 },
        { "specific_enthalpy_j_kg": 1000, "temperature_k": 350, "liquid_mass_fraction": 0 },
        { "specific_enthalpy_j_kg": 3000, "temperature_k": 350, "liquid_mass_fraction": 1 },
        { "specific_enthalpy_j_kg": 4500, "temperature_k": 500, "liquid_mass_fraction": 1 }
