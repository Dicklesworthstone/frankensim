      "initial_specific_enthalpies_j_kg": [500, 2000, 2100, 2200],
      "newton": {
        "max_iterations": 32,
        "residual_rtol": 1e-12,
        "residual_atol_j": 1e-10,
        "linear_restart": 4,
        "max_linear_cycles": 8,
        "armijo_c": 1e-4,
        "shrink": 0.5,
        "max_backtracks": 24
      }
    },
    "max_step_s": 0.125,
    "max_steps": 8,
    "intervals": [
      { "duration_s": 0.25, "power_scale": 1 },
      { "duration_s": 0.25, "power_scale": 0.25 }
    ],
    "adjoint": {
      "qoi": "final",
      "max_checkpoint_bytes": 1048576,
      "component_power": true
    }
