{
  "schema": "frankensim.cooling-network.v1",
  "units": "SI",
  "seed": "80",
  "budgets": {
    "graph_sweeps": 100,
    "coupling_iterations": 100,
    "linear_iterations": 2000,
    "derivative_iterations": 100,
    "wall_seconds": 120
  },
  "tolerances": {
    "flow_m3_s": 1e-12,
    "heat_w": 1e-7,
    "temperature_k": 1e-9,
    "linear_relative": 1e-12,
