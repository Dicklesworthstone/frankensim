  },
  "air": { "density_kg_m3": 1, "specific_heat_j_kg_k": 1 },
  "hydraulics": {
    "node_count": 2,
    "boundaries": [
      { "node": 0, "pressure_pa": 1, "temperature_k": 300 },
      { "node": 1, "pressure_pa": 0 }
    ],
    "branches": [{
      "name": "air",
      "from": 0,
      "to": 1,
      "resistance_pa_s2_m6": 1,
      "source": "Synthetic unit-flow exchanger",
      "regions": ["wall"]
    }]
  },
  "recirculation": {
    "model": "prescribed-adiabatic-return",
    "source": "Synthetic 60 percent exhaust return with imposed pressure reset",
