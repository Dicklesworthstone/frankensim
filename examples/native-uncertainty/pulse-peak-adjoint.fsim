; Freeze one native selected-peak branch adjoint before drawing random inputs.
; Ties supply fixed centered mean controls, not a unique-maximum derivative claim.
; Illustrative uniform operating inputs, not measured probability laws.
; The referenced startup pulse retains its declared synthetic heat capacity.
(fsim-uncertainty-study
  :version 3
  :mean-control (nominal-adjoint :max-solves 1)
  :project "../heatsink-fan/heatsink-fan-pulse.fsim"
  :samples 8
  :seed 29
  :wall-time 240s
  :method monte-carlo
  :correlation independent
  :qoi "temperature-peak"
  :geometry (
    (mesh :role "heatsink" :path "../heatsink-fan/heatsink.stl"
      :unit "m" :max-hole-edges 0))
  :materials ("../../data/reference-project/aa6061.fsmcdpk")
  :interfaces ()
  :parameters (
    (uniform :name "fan-speed" :target fan-speed-ratio :entity "heatsink-bank"
      :low 0.6 :high 0.8)
    (uniform :name "inlet-temperature" :target air-inlet-temperature :entity "metal"
      :low 293.15K :high 303.15K)))
