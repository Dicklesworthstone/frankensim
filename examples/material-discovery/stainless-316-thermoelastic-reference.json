{
  "schema": "frankensim.discovery.v1",
  "target": "properties",
  "properties": [
    {"name": "density", "unit": "kg/m3", "kind": "dimensional"},
    {"name": "young_modulus", "unit": "Pa", "kind": "dimensional"},
    {"name": "poisson_ratio", "unit": "1", "kind": "dimensional"},
    {"name": "specific_heat_capacity", "unit": "J/kg/K", "kind": "dimensional"},
    {"name": "thermal_conductivity", "unit": "W/m/K", "kind": "thermal-conductivity"},
    {"name": "linear_thermal_expansion_coefficient", "unit": "K-1", "kind": "dimensional"}
  ],
  "models": [],
  "domain": {
    "mode": "envelope",
    "axes": [
      {"name": "T", "kind": "absolute-temperature", "lower": "293.15 K", "upper": "293.15 K"},
      {"name": "source-pressure-known", "kind": "dimensional", "lower": "0", "upper": "0"}
    ]
  },
  "selection": "single-claim-only"
}
