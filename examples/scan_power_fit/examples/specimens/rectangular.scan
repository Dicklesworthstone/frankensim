FS_SCAN_SPECIMEN_V1
# Manufactured rectangular specimen: 2 m^3, density 2 kg/m^3, mass 4 kg.
conductivity_w_m_k 2
reference_density_kg_m3 2
initial_specific_enthalpy_j_kg 150
switch_time_s 1.5
end_time_s 4
first_center_m 1 0.5 0.5
second_center_m 1 0.5 0.5
half_width_m 3 2 2
exterior adiabatic
# Specific enthalpy J/kg, temperature K, liquid mass fraction.
phase_knot -200 280 0
phase_knot 100 310 0
phase_knot 200 310 1
phase_knot 900 380 1
vertex_m 0 0 0
vertex_m 2 0 0
vertex_m 0 1 0
vertex_m 2 1 0
vertex_m 0 0 1
vertex_m 2 0 1
vertex_m 0 1 1
vertex_m 2 1 1
# Zero-based vertex rows. Each tetrahedron has positive signed volume.
tet 0 1 3 7
tet 0 3 2 7
tet 0 2 6 7
tet 0 6 4 7
tet 0 4 5 7
tet 0 5 1 7
