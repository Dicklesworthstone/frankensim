{
  "schema": "frankensim.system.v0",
  "duration_s": 4.0,
  "step_s": 0.5,
  "sample_every_s": 0.1,
  "adaptive": {
    "order": 2,
    "min_step_s": 1e-12,
    "max_attempts": 32,
    "tolerances": {
      "block.position_m": {"absolute": 1e-5, "relative": 0},
      "block.velocity_m_s": {"absolute": 1e-5, "relative": 0},
      "spring.extension_m": {"absolute": 1e-5, "relative": 0},
      "drive.energy_in_j": {"absolute": 1e-6, "relative": 0}
    }
  },
  "elements": {
    "block": {"kind": "mass", "mass_kg": 1.0, "position_m": 0.2, "velocity_m_s": 0.0},
    "spring": {"kind": "spring", "stiffness_n_m": 4.0, "extension_m": -0.2},
    "drive": {"kind": "force", "force_n": 0.4}
  },
  "connections": [
    {"join": ["block.p", "spring.a", "drive.p"]},
    {"prescribe": "spring.b", "velocity_m_s": 0}
  ]
}
