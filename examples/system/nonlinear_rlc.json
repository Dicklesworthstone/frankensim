{
  "schema": "frankensim.system.v0",
  "duration_s": 0.5,
  "step_s": 0.0005,
  "sample_every_s": 0.005,
  "elements": {
    "capacitor": {
      "kind": "nonlinear_capacitor",
      "charge_voltage_curve": [[-0.04, -6.0], [-0.02, -2.0], [0.0, 0.0], [0.02, 2.0], [0.04, 6.0]],
      "charge_c": 0.032
    },
    "coil": {
      "kind": "nonlinear_inductor",
      "flux_current_curve": [[-0.1, -3.0], [-0.05, -1.0], [0.0, 0.0], [0.05, 1.0], [0.1, 3.0]],
      "flux_wb": -0.04
    },
    "load": {"kind": "resistor_branch", "resistance_ohm": 10.0},
    "source": {"kind": "current_source", "current_a": -0.05},
    "case": {"kind": "heat_capacity", "capacity_j_k": 10.0, "temperature_k": 300.0}
  },
  "connections": [
    {"common_effort": ["capacitor.p", "coil.p", "load.a", "source.p"]},
    {"prescribe": "load.b", "voltage_v": 0},
    {"route": "load.heat", "to": [["case.heat", 1.0]]}
  ]
}
