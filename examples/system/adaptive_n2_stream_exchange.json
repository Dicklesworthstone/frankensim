{
  "schema": "frankensim.system.v0",
  "duration_s": 1.0,
  "step_s": 0.1,
  "sample_every_s": 0.1,
  "adaptive": {
    "order": 1,
    "min_step_s": 1e-7,
    "max_attempts": 40,
    "tolerances": {
      "left.volume_m3": {"absolute": 1e-12, "relative": 0},
      "left.temperature_k": {"absolute": 1e-3, "relative": 0},
      "left.mass_kg": {"absolute": 1e-9, "relative": 0},
      "left.energy_j": {"absolute": 1e-4, "relative": 0},
      "left.species0_mass_kg": {"absolute": 1e-9, "relative": 0},
      "right.volume_m3": {"absolute": 1e-12, "relative": 0},
      "right.temperature_k": {"absolute": 1e-3, "relative": 0},
      "right.mass_kg": {"absolute": 1e-9, "relative": 0},
      "right.energy_j": {"absolute": 1e-4, "relative": 0},
      "right.species0_mass_kg": {"absolute": 1e-9, "relative": 0}
    }
  },
  "elements": {
    "a_valve": {"kind": "restriction", "conductance_kg_s_pa": 2.0e-9,
                "stream_basis": "left.stream"},
    "left": {"kind": "gas_cavity", "gas": "thermochemical 300 90000 mole 1 N2 1",
             "sources": [{"species": "n2/species.pack", "nasa9": "n2/nasa9.pack",
