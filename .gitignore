# Rust build output
/target/
target/

# Cargo temporary files
**/*.rs.bk

# Keep Cargo.lock tracked by default for this workspace.
# If a future crate is a pure library with a deliberate policy to omit it,
# change that policy explicitly instead of ignoring it here.

# Rust profiling and coverage output
*.profraw
*.profdata
/coverage/
/tarpaulin-report.html
/lcov.info
/cobertura.xml

# Criterion and benchmark scratch output outside target/
/criterion/
/bench-output/
/bench-results/

# Flamegraph and perf artifacts
perf.data
perf.data.old
flamegraph.svg
flamegraph.folded

# Generated docs
/doc/
/docs/generated/

# Local databases and ledgers
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Beads local runtime state. Keep durable issue exports tracked.
.beads/.br_history/
.beads/*.lock
.beads/.*.lock
# Renamed stale locks keep the original name plus a .stale-<timestamp> suffix,
# which the two patterns above miss.
.beads/*.lock.stale-*
.beads/.*.lock.stale-*
.beads/beads.db
.beads/beads.db-*
.beads/last-touched

# Logs and local scratch files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig
/tmp/
/scratch/

# Environment and local secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# macOS and editor metadata
.DS_Store
._*
.AppleDouble
.LSOverride
.idea/
.vscode/
*.iml

# Linux and Windows metadata
*~
Thumbs.db
ehthumbs.db
Desktop.ini

# RCH and local remote-build scratch directories
/rch_target*/
/remote-target*/
# An unexpanded ${RCH_TARGET_BASE:-${TMPDIR:-/tmp}} (single-quoted through a
# wrapper) creates this literal directory tree at the repo root.
/$[{]TMPDIR:-*/
# Default rustc output when compiling a snippet from stdin.
/rust_out

# Generated package artifacts
*.crate
*.tar.gz
*.zip
*.dSYM/

# Source illustration asset. The README uses the compressed WebP.
frankensim_illustration.png

# bv (beads viewer) local config and caches
.bv/

# Beads compliance audit dir (managed by /beads-compliance-and-completion-verification skill)
/beads_compliance_audit/
# br doctor per-run artifacts
.doctor/

# Cloudflare wrangler CLI local state (already skipped by xtask traversal)
/.wrangler/

# === multi-repo ephemeral cleanup 2026-08-03 ===
# Beads SQLite repair/backup snapshots (dotted suffix, distinct from
# beads.db-wal / beads.db-shm which are covered by beads.db-*).
.beads/beads.db.pre-*
.beads/*.pre-repair*

# === multi-repo ephemeral patterns 2026-08-10 ===
# Eidetic Engine local runtime memory (machine-local DB/WAL/locks)
.ee/
# NTM agent swarm runtime (logs, pids, rate limits)
.ntm/
# Claude Code local session state (nothing tracked here)
.claude/
# Local one-off audio probe dumps (never fixtures)
/test.m4a
# br fsqlite-ns VFS sidecars — per-machine runtime state, like -wal/-shm
.beads/beads.db-fsqlite-ns-*
# Recoverable Beads write-lock snapshots moved aside when stale
.beads/.write.lock.stale-*
# git-repo-janitor skill scratch workspace
.repo_janitor_workspace/
# Skill-loop progress scratch
.skill-loop-progress.md
.skill-loop-progress-*.md
